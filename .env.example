# ========================================================
# DIGITAL LEGACY MANAGER - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual values.
# .env is excluded from git via .gitignore.
# ========================================================

# Database Configuration (Aiven Cloud or Local MySQL)
DATABASE_HOST=your-mysql-host.aivencloud.com
DATABASE_PORT=23608
DATABASE_NAME=defaultdb
DATABASE_USERNAME=avnadmin
DATABASE_PASSWORD=your_secure_database_password_here

# Spring Boot Datasource
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:mysql://your-mysql-host.aivencloud.com:23608/defaultdb?sslMode=REQUIRED&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=avnadmin
SPRING_DATASOURCE_PASSWORD=your_secure_database_password_here

# JWT Security Configuration
APP_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
APP_JWT_EXPIRATION_MS=86400000

# Cryptography (AES-256 Vault Key)
APP_SECURITY_AES_SECRET_KEY=636173686c6567616379736563757265

# Storage Vault Directory
APP_STORAGE_UPLOAD_DIR=./uploads/documents

# Allowed CORS Origins (comma-separated)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://*.vercel.app
